---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Theremin"
  description="A pointer-driven theremin — press and drag to play. Left/right changes pitch, up/down changes tone."
>
  <header>
    <nav aria-label="Primary">
      <a href="./">Home</a>
    </nav>
  </header>
  <main id="pad">
    <h1>Theremin</h1>
    <p>Press and drag to play</p>
  </main>
  <div id="cursor" aria-hidden="true"></div>
  <script src="../scripts/main.ts"></script>
</Layout>
